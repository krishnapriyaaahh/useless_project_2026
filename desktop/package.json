{
  "name": "amma-radar",
  "version": "1.0.0",
  "description": "Amma Radar™ — Because headphones aren't an excuse.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "keywords": [],
  "author": "Krishna",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.amma.radar",
    "productName": "Amma Radar",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icons/icon.ico"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
